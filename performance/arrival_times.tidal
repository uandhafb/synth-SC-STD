-- ARRIVAL TIMES · tempos de chegada
-- terremotos, o sintetizador scstd, TidalCycles e uma sala de celulares
--
-- Antes: SuperCollider (sc/startup.scd), o relay (node performance/quake-relay.js), um Tidal só.
-- Rodar um bloco: cursor dentro dele, Cmd+Enter. Cada bloco é um parágrafo (sem linhas vazias).
--
-- O que a Terra manda (sempre entre 0 e 1):
--   qmag     a força do último terremoto            qdepth   a profundidade dele
--   qenergy  a agitação agora (sobe a cada abalo, some em ~20 s)
--   qrate    quantos abalos nos últimos 30 s        qlat, qlon   onde foi
--   qground  AO VIVO: o chão de Montréal agora (sismômetro CN.MNTQ)

-- ============================================================================================
-- 0 · PRIMEIRO (uma vez, um de cada vez): os nomes do synth, o tempo, os dados
-- ============================================================================================

:script /Users/uandha/tidal-setups/names.hs

setcps 0.55

let qmag = cF 0 "mag"; qdepth = cF 0.5 "depth"; qenergy = cF 0 "energy"; qrate = cF 0 "rate"; qlat = cF 0.5 "lat"; qlon = cF 0.5 "lon"; qground = cF 0 "ground"

-- ============================================================================================
-- 1 · VOCABULÁRIO · cada nome é um som do synth (rodar este bloco inteiro uma vez)
--     Os nomes entre parênteses à direita dizem que parte do synth faz o som.
-- ============================================================================================

let -- NUCLEO · o que gira no escuro e nunca para            (mono: osciladores + ruído + filtro)
    nucleo = n "-22*4" # s "scstd" # monomode 1 # legato 1.05 # orbit 2
      # o1lvl 0.4 # o2lvl 0.3 # o2wave 2 # o3lvl 0.7 # nzlvl 0.2 # nzcol 0.9 # drift 0.6
      # vcfcut 300 # vcfres 0.55 # vcfenv 0 # vcfkey 0 # sh_vcf 0.4 # shrate 0.7 # shlag 1
      # vcalvl 0.8 # spmix 0.35 # spdecay 0.8
    -- CHAO · o chão daqui, agora                              (AO VIVO: o sismômetro de Montréal abre o filtro e o volume)
    chao = n "9*16" # s "scstd" # monomode 1 # legato 1.05 # orbit 6
      # o1lvl 0 # o2lvl 0.7 # o2wave 3 # o3lvl 0 # nzlvl 1 # nzcol 0.3 # vcfdrive 0.8
      # vcfcut (range 150 5000 qground) # vcfres 0.85 # vcfenv 0 # vcfkey 0 # vcalvl (range 0.15 1 qground) # spmix 0.3 # gain 0.5
    -- MANTO · pedra que escorre devagar, por séculos        (acordes com PWM)
    manto = n "<[2,5,9] [0,4,7] [-2,2,5] [-3,0,4]>/2" # s "scstd" # legato 1 # orbit 3
      # o1lf 1 # o1lfrate 0.8 # o1lvl 0 # o2wave 1 # o2pwm 0.8 # o3lvl 0.6 # o3wave 1 # o3pwm 0.6 # o3oct 0 # o3fine (-0.08)
      # vcfcut 1800 # vcfres 0.2 # vcfenv 0.1 # aratk 0.4 # arrel 1.2 # erel 1.2 # vcalvl 0.5 # spmix 0.5 # spdecay 0.8
    -- MAGMA · o chão antes de ser chão                       (baixo ácido: filtro + drive)
    magma = n "-22 [-22 -10] ~ -22 [~ -15] -22 <-17 -19> [-10 -12]" # s "scstd" # legato 0.7 # orbit 1
      # o2wave 1 # o2pw 0.35 # o3lvl 0.5 # vcfcut 250 # vcfres 0.8 # vcfenv 0.7 # vcfdrive 0.9
      # edec 0.18 # esus 0 # arrel 0.1 # erel 0.1 # spmix 0.1
    -- FALHA · onde a terra guarda a sua pressa               (bumbo + o VCO 1 lento, estalando por baixo)
    falha = stack [
        n "-26 ~ ~ -26 ~ ~ -26 ~" # s "scstd" # legato 0.2 # orbit 0
          # o1lvl 0 # o2wave 3 # o2lvl 1 # o3lvl 0 # nzlvl 0.05 # adsr_pitch 30 # eatk 0.001 # edec 0.09 # esus 0
          # vcfcut 3000 # vcfenv 0.3 # vcfdrive 0.8 # aratk 0.001 # arrel 0.18 # erel 0.18 # vcalvl 1 # spmix 0,
        n "-14" # s "scstd" # legato 1 # orbit 0
          # o1lf 1 # o1lfrate 8.8 # o1lvl 0.8 # o2lvl 0 # vcfcut 4000 # vcfenv 0 # vcfres 0.3 # vcalvl 0.45 # spmix 0 ]
    -- PLACAS · continentes que se empurram sem se ver        (tons, ritmo euclidiano)
    placas = off 0.25 (|+ n 4) $ n "-14(5,8)" # s "scstd" # legato 0.3 # orbit 0
      # o1lvl 0 # o2wave 3 # o2lvl 1 # adsr_pitch 12 # eatk 0.001 # edec 0.15 # esus 0
      # vcfcut 800 # vcfenv 0.3 # aratk 0.001 # arrel 0.25 # erel 0.25 # spmix 0
    -- POEIRA · o que fica no ar depois                       (ruído branco curtíssimo)
    poeira = n "0*16" # s "scstd" # legato 0.05 # orbit 0
      # o1lvl 0 # o2lvl 0 # nzlvl 1 # nzcol 0.1 # aratk 0.001 # arrel 0.04 # erel 0.04
      # vcfcut 9000 # vcfenv 0 # vcfmodel 1 # spmix 0
    -- CASCALHO · pedra miúda, estalando                      (caixa: ruído + triângulo grave)
    cascalho = n "~ -14 ~ [-14 ~ ~ -14]" # s "scstd" # legato 0.1 # orbit 0
      # o1lvl 0 # o2lvl 0.9 # o2wave 2 # nzlvl 1 # aratk 0.001 # arrel 0.15 # erel 0.15
      # vcfcut 4000 # vcfenv 0 # vcfdrive 0.9 # vcalvl 1 # spmix 0
    -- SISMOGRAFO · a agulha que escreve o que ninguém sentiu (notas no tom; o sample & hold treme o filtro)
    sismografo = n "2 [~ 9] 5 <12 14> [2 2] ~ 9 <5 7>" # s "scstd" # legato 0.8 # orbit 5
      # o1lvl 0 # o2lvl 1 # o2wave 1 # o2pw 0.3 # sh_vcf 2 # shrate 8 # vcfcut 900 # vcfres 0.7 # vcfenv 0 # vcfdrive 0.7 # vcalvl 1
      # arrel 0.1 # erel 0.1 # spmix 0.25
    -- TREMOR · o copo d'água sabe primeiro                   (chave eletrônica: trinado)
    tremor = n "<2 9 5 0>" # s "scstd" # legato 1 # orbit 5
      # o1lvl 0 # o2lvl 0 # swlvl 1 # swrate 12 # o3oct 0.1667 # vcfcut 3000 # spmix 0.25
    -- FENDA · a linha que não estava no mapa                 (hard sync varrendo)
    fenda = n "2 5 9 12 14 12 9 5" # s "scstd" # legato 0.8 # orbit 5
      # o1lvl 0.2 # o2sync 1 # o2oct (range 0.6 2 $ slow 2 sine) # vcfcut 2500 # vcfres 0.3 # vcfenv 0.3 # vcfkey 0.7
      # edec 0.4 # esus 0.5 # spmix 0.25
    -- REPLICA · a terra repetindo a frase, mais baixo        (sino de ring modulator)
    replica = n "2 ~ ~ 9 ~ ~ 5 ~" # s "scstd" # legato 0.05 # orbit 3
      # o1oct 0.485 # o1lvl 0 # o2wave 3 # o2lvl 0.25 # rmlvl 1 # vcalvl 1 # aratk 0.001 # eatk 0.001 # esus 0
      # vcfkey 1 # vcfdrive 0 # drift 0.05 # vspread 0 # arrel 3.5 # erel 3.5 # edec 1.8 # vcfcut 900 # vcfenv 0.45
      # spmix 0.5 # spdecay 0.8
    -- CRISTAL · o que a pressão fez de bonito                (sino de vidro, agudo)
    cristal = n "<14 21> ~ 26 ~ [~ 19] ~ 26 ~" # s "scstd" # legato 0.05 # orbit 3
      # o1oct 1.28 # o1lvl 0 # o2wave 3 # o2lvl 0.25 # rmlvl 1 # vcalvl 1 # aratk 0.001 # eatk 0.001 # esus 0
      # vcfkey 1 # vcfdrive 0 # drift 0.05 # vspread 0 # arrel 2.5 # erel 2.5 # edec 0.9 # vcfcut 1500 # vcfenv 0.35
      # spmix 0.5 # spdecay 0.8
    -- VENTO · o planeta respirando por cima                  (ruído + filtro ressonante + S&H lento)
    vento = slow 7 $ n "0" # s "scstd" # legato 1.2 # orbit 4
      # o1lvl 0 # o2lvl 0 # nzlvl 1 # nzcol 0.5 # vcfenv 0 # vcfkey 0 # sh_vcf 3 # shrate 1.2 # shlag 1
      # vcfcut 1000 # vcfres 0.9 # aratk 1 # arrel 2 # erel 2 # spmix 0.4 # gain (0.3)
    -- LAVA · luz líquida                                      (FM: o VCO 3 dobrando a afinação de todos)
    lava = n "<2 5 9 7>" # s "scstd" # legato 1 # orbit 4
      # o1lvl 0 # o2wave 3 # o3kbd 0 # o3oct (-1) # vco3_pitch 4 # vcfcut 4000 # vcfenv 0
      # arrel 1.5 # erel 1.5 # aratk 0.3 # vcalvl 0.55 # spmix 0.4
    -- ONDAP · a primeira a chegar, a que avisa               (bipes agudos caindo)
    ondaP = n "14(5,8,<0 3>)" # s "scstd" # legato 0.2 # orbit 0
      # o1lvl 1 # o2lvl 0 # adsr_pitch 24 # eatk 0.001 # edec 0.08 # esus 0 # vcfenv 0.3 # vcfdrive 0.8 # vcalvl 1 # arrel 0.06 # erel 0.06 # spmix 0
    -- ONDAS · a segunda, a que derruba                       (baixo que pulsa: LFO no volume)
    ondaS = n "-22 ~ -22 <-19 -24>" # s "scstd" # legato 1 # orbit 1
      # o1lf 1 # o1lfrate 6 # o1wave 1 # o1lvl 0 # vco1_vca (-0.6) # o3lvl 0.8
      # vcfcut 500 # vcfres 0.6 # vcfdrive 1 # vcfenv 0.2 # spmix 0.1
    -- SOMBRA · o lugar onde a onda não chega                 (FM: o VCO 3 solto do teclado, torcendo a afinação)
    sombra = n "<-10 -7 -3 -5>" # s "scstd" # legato 1 # orbit 3
      # o1lvl 0 # o2wave 3 # o3kbd 0 # o3oct (-1) # vco3_pitch 4 # vcfcut 1800 # vcfenv 0
      # aratk 0.5 # arrel 1.5 # erel 1.5 # vcalvl 0.5 # spmix 0.5 # spdecay 0.8
    -- RESPINGO · a água que salta quando a pedra racha       (dedilhado curto afogado na mola)
    respingo = n "2 ~ ~ 14 ~ ~ 9 ~" # s "scstd" # legato 0.1 # orbit 10
      # vcfenv 0.7 # vcfcut 600 # edec 0.15 # esus 0 # spmix 0.8 # sptone 0.8 # spdecay 0.5
    -- BORBULHA · o gás subindo pela rocha, sem pressa         (mono: o sample & hold borbulha o filtro sem recomeçar)
    borbulha = n "2 5 7 9" # s "scstd" # monomode 1 # legato 1.1 # orbit 8
      # sh_vcf 2 # shrate 3 # vcfcut 700 # vcfres 0.6 # spmix 0.2
    -- VOZ · quem fala, fala de dentro da pedra                (MICROFONE pelo filtro, borbulhando, com mola)
    voz = n "0" # s "scstd" # monomode 1 # legato 1 # orbit 9
      # o1lvl 0 # o2lvl 0 # inlvl 1 # vcaenv 0 # vcfcut 900 # vcfres 0.8 # sh_vcf 2 # shrate 5 # spmix 0.6
    -- ASSOBIO · o vento achando uma fresta                    (o filtro cantando sozinho, sem osciladores)
    assobio = n "0" # s "scstd" # legato 1 # orbit 3
      # o1lvl 0 # o2lvl 0 # vcfres 1.1 # vcfenv 0 # vcfkey 0 # vcfcut "<587 880 698 440>" # vcalvl 0.35
      # aratk 0.3 # arrel 1 # erel 1 # spmix 0.5 # spdecay 0.8
    -- BRASA · o que ainda está quente                         (sino de FM)
    brasa = n "2 ~ 9 ~ 14 ~ 5 ~" # s "scstd" # legato 0.1 # orbit 3
      # o1oct 0.485 # o1lvl 0 # o2wave 3 # o2fm 0.12 # vcfcut 12000 # vcfenv 0 # aratk 0.001 # arrel 2.5 # erel 2.5
      # vcalvl 0.7 # spmix 0.5 # spdecay 0.8
    -- CIGARRA · bicho que sente antes da gente                (assobios que escorregam)
    cigarra = n "<14 21 17 26>" # s "scstd" # legato 0.9 # orbit 5
      # o1lf 1 # o1lfrate 16 # o1lvl 0 # o2wave 3 # o2lvl 1 # o2fm 0.035 # sh_pitch 5 # shrate 8 # shlag 0.55
      # vcfcut 5000 # vcfenv 0 # vcfdrive 0 # drift 0 # vcalvl 0.6 # spmix 0.25
    -- CALOR · o ar tremendo em cima da pedra                  (acordes com trêmulo: LFO no volume)
    calor = n "<[2,5,9] [0,4,7] [-2,2,5] [-3,0,4]>" # s "scstd" # legato 1 # orbit 3
      # o1lf 1 # o1lfrate 6 # o1wave 1 # o1lvl 0 # vco1_vca (-0.6) # vcalvl 0.6 # spmix 0.5 # spdecay 0.8
    -- AREIA · mil grãos discutindo                            (ruído sacudindo o filtro)
    areia = n "-10 -3" # s "scstd" # legato 1 # orbit 1
      # vcfcut 600 # vcfres 0.6 # noise_vcf 1.5 # spmix 0.1
    -- QUARTZO · cada face, outra cor                          (sample & hold na largura do pulso)
    quartzo = n "-10 [~ -10] -3 -5" # s "scstd" # legato 1 # orbit 5
      # o1lvl 0 # o2wave 1 # sh_pw 0.9 # shrate 6 # vcfcut 3000 # vcfenv 0 # spmix 0.25
    -- ESTATICA · o rádio entre duas estações                  (ring modulator: seno x ruído)
    estatica = n "2 9" # s "scstd" # legato 1 # orbit 4
      # o1lvl 0 # o2lvl 0 # o2wave 3 # rmlvl 1 # rma 1 # rmb 3 # vcfcut 5000 # vcfenv 0 # vcalvl 0.6 # spmix 0.4
    -- GEISER · a pressão achando saída                        (envelope invertido: a nota nasce grave e sobe)
    geiser = n "-10 ~ -3 ~" # s "scstd" # legato 1 # orbit 5
      # mixa 5 # mixalvl (-1) # mixblvl 0 # mix_pitch 12 # eatk 0.001 # edec 0.5 # esus 0 # spmix 0.25
    -- ESTRATOS · o tempo empilhado em degraus                 (sample & hold lendo uma rampa: escada)
    estratos = n "2" # s "scstd" # legato 1 # orbit 5
      # shsrc 1 # o1lf 1 # o1lfrate 0.75 # o1lvl 0 # sh_pitch 12 # shrate 6 # vcfcut 3000 # vcfenv 0 # spmix 0.25
    -- SOPRO · tua voz abrindo a pedra                         (MICROFONE: o volume da voz abre o filtro; a voz não passa)
    sopro = n "-10" # s "scstd" # monomode 1 # legato 1 # orbit 11
      # envf_vcf 4 # vcfcut 200 # vcfres 0.5 # vcfenv 0 # spmix 0.3
    -- PEGADAS · cada tecla, um passo no chão                  (MICROFONE: o estalo de digitar abre a nota e o filtro)
    pegadas = n "<9 14 12 17>" # s "scstd" # legato 1 # orbit 5
      # o1lvl 0.4 # o2wave 1 # o2pw 0.3 # vcaenv 0 # vcainit 0 # envf_vca 1 # envf_vcf 3 # vcfcut 400 # vcfres 0.7 # vcfenv 0
      # efatk 0.002 # efrel 0.12 # ingain 0.55 # spmix 0.25
    -- SINAL · alguém, em algum lugar, tentando avisar        (bipes que "falam")
    sinal = degradeBy 0.35 $ n (segment 16 $ (0.37 <~ irand 24) + 12) # s "scstd" # orbit 5
      # o1lf 1 # o1lvl 0 # o2wave 3 # o2lvl 1 # vcalvl 1 # aratk 0.003 # arrel 0.03 # erel 0.03
      # vcfcut 6000 # vcfenv 0 # vcfdrive 0 # drift 0 # o1lfrate (range 4 30 $ 0.13 <~ rand)
      # o2fm (range 0 0.2 $ 0.71 <~ rand) # legato (range 0.4 0.9 $ 0.53 <~ rand) # spmix 0.25

-- ============================================================================================
-- 2. TESTANDO E CALIBRANDO
-- ============================================================================================

d1 $ stack [silence
  -- ---- o chão respira ---------------------------------------------------------------
  -- , nucleo # vcfcut (range 120 900 qground) # nzlvl (range 0.1 0.5 qground)
  -- , chao # gain 1.1
  -- , slow 2 $ vento # gain 0.85 # pan (slow 8 sine)
   --, sombra # gain 0.8
  -- ---- a falha ----------------------------------------------------------------------
  -- , falha # o1lfrate (range 4 14 qrate) # gain 1.15
  -- , respingo # spdecay "<0 0.5 1>" # gain 0.9
  --, degradeBy (range 0.9 0.2 qrate) $ poeira # pan rand # gain 0.8
  --, every 4 (off 0.125 (|+ n 12)) $ magma # vcfcut (range 200 2500 qmag)
  -- , whenmod 8 6 (hurry 2) $ placas # pan (slow 3 sine) # gain 0.85
  -- , cascalho # gain 1.15
  -- ---- o enxame ---------------------------------------------------------------------
  --, every 3 (jux rev) $ sismografo # sh_vcf (range 0.5 3.5 qenergy) # shrate (range 4 16 qrate) # gain 1
  -- , sometimesBy 0.3 (# crush 5) $ fenda # gain 0.7 # pan (fast 2 sine)
  -- , ondaP # pan rand # gain 1
  -- , borbulha # sh_vcf (range 1 3.5 qenergy) # gain 0.9
  -- , tremor # swrate (range 6 24 qenergy) # gain 0.7
  -- ---- a ruptura (teclas 1 2 3 no relay) --------------------------------------------
  -- , manto # gain 1
  -- , off 0.375 (# gain 0.6) $ replica # gain 0.8
  -- , lava # vco3_pitch (range 1 9 qenergy) # gain 0.75
  -- , degradeBy 0.5 $ cristal # pan rand # gain 0.6
  -- ---- as réplicas ------------------------------------------------------------------
  -- , ondaS # o1lfrate (range 3 12 qenergy) # gain 0.9
  -- , sinal # pan rand # gain 0.7
  -- ---- minerais, bichos, cores ------------------------------------------------------
  -- , assobio # gain 0.75
  -- , brasa # gain 0.8
  -- , cigarra # pan (slow 5 sine) # gain 0.7
  -- , calor # o1lfrate (range 3 14 qenergy) # gain 0.8
  -- , areia # noise_vcf (range 0.3 2.5 qenergy) # gain 0.85
  -- , quartzo # shrate (range 3 14 qrate) # gain 0.8
  -- , estatica # pan rand # gain 0.7
  -- , geiser # gain 0.85
  -- , estratos # o1lfrate (range 0.3 1.5 qenergy) # gain 0.75
  -- ---- a voz (MICROFONE: com caixas de som, volume baixo, senão apita) ---------------
  -- , pegadas # gain 1
  -- , sopro # gain 0.9
  -- , voz # gain 0.8
  ]

-- ============================================================================================
-- 3 · ARRANJO
-- ============================================================================================

let arranjo = seqPLoop
      -- o chão respira
      [ (0, 152, nucleo # vcfcut (range 120 1100 qenergy) # nzlvl (range 0.1 0.5 qground) # gain 0.85)
      , (3, 24, slow 2 $ vento # gain 0.05 # pan (slow 8 sine))
      , (2, 13, chao # gain 0.05)
      , (4, 20, sombra # gain 0.5 pan (fast 5 sine))
      , (10, 18, assobio # gain 0.65)
      -- a falha
      , (21, 80, falha # o1lfrate (range 4 14 qrate) # gain 0.25)
      , (28, 80, respingo # spdecay "<0 0.5 1>" # gain 0.5)
      , (13, 80, degradeBy (range 0.5 0.2 qrate) $ poeira # pan rand # gain 0.75)
      , (25, 80, every 4 (off 0.125 (|+ n 12)) $ magma # vcfcut (range 200 2500 qmag))
      , (32, 80, whenmod 8 6 (hurry 2) $ placas # pan (slow 3 sine) # gain 0.85)
      , (13, 80, cascalho # gain 0.7r5 # pan rand)
      -- o enxame
      , (128, 140, every 3 (jux rev) $ sismografo # sh_vcf (range 0.5 3.5 qenergy) # shrate (range 4 16 qrate) # gain 1)
      , (128, 141, sometimesBy 0.3 (# crush 5) $ fenda # gain 0.7 # pan (fast 2 sine))
      , (128, 142, borbulha # sh_vcf (range 1 3.5 qenergy) # gain 0.9)
      , (60, 80, areia # noise_vcf (range 0.3 2.5 qenergy) # gain 0.55)
      , (54, 80, ondaP # pan rand # gain 0.7)
      , (68, 80, estratos # o1lfrate (range 0.3 1.5 qenergy) # gain 0.5)
      , (72, 80, tremor # swrate (range 6 24 qenergy) # gain 0.5)
      -- a ruptura
      , (80, 100, manto # gain 1)
      , (80, 100, off 0.375 (# gain 0.6) $ replica # gain 0.8)
      , (84, 96, lava # vco3_pitch (range 1 9 qenergy) # gain 0.75)
      , (88, 100, degradeBy 0.5 $ cristal # pan rand # gain 0.6)
      , (86, 100, brasa # gain 0.75)
      , (92, 100, calor # o1lfrate (range 3 14 qenergy) # gain 0.7)
      -- as réplicas
      , (100, 128, every 8 (hurry 2) $ falha # o1lfrate (range 4 14 qrate) # gain 1.15)
      , (100, 128, respingo # spdecay "<1 0.5 0>" # gain 0.9)
      , (104, 128, borbulha # sh_vcf (range 1 3.5 qenergy) # gain 0.9)
      , (100, 128, degradeBy (range 0.8 0.1 qrate) $ poeira # pan rand # gain 0.8)
      , (100, 128, cascalho # gain 1.15)
      , (100, 128, ondaS # o1lfrate (range 3 12 qenergy) # gain 0.9)
      , (104, 128, every 4 (off 0.125 (|+ n 12)) $ magma # vcfcut (range 300 3500 qmag) # crush (range 16 5 qenergy))
      , (108, 128, every 2 (jux rev) $ sismografo # sh_vcf (range 0.5 3.5 qenergy) # gain 1)
      , (116, 128, tremor # swrate (range 6 24 qenergy) # gain 0.7)
      , (108, 124, quartzo # shrate (range 3 14 qrate) # gain 0.8)
      , (112, 128, geiser # gain 0.85)
      -- agora  o chão de Montréal ao vivo (chao), a sombra e um sinal
      , (126, 152, chao # gain 0.05)
      , (128, 152, manto # vcfcut (range 500 3500 qground) # gain 0.8)
      , (130, 150, sombra # vco3_pitch (range 1 9 qground) # gain 0.8)
      , (132, 150, degradeBy (range 0.95 0.1 qground) $ estatica # pan rand # gain 0.6)
      , (136, 150, degradeBy (range 0.97 0.3 qground) $ sinal # pan rand # gain 0.6)
      , (140, 150, cigarra # pan (slow 5 sine) # gain 0.6)
      , (128, 152, tremor # swrate (range 3 30 qground) # gain 0.6)
      , (128, 152, n (toScale [0,2,3,5,7,8,10] (floor <$> segment 8 (range 0 14 qground))) # s "scstd" # legato 0.5 # vcfcut 1800 # spmix 0.4 # orbit 5 # gain 0.8)

      ]

do resetCycles
   d1 $ arranjor

-- ============================================================================================
-- FIM · o silêncio
-- ============================================================================================

hush
