-- synth-SC-STD examples. Needs sc/startup.scd running and the project BootTidal.hs loaded.
-- Click on a line (or a block) and press Shift+Enter. `hush` stops everything.

hush

-- =============================================================================================
-- Stage 1 — single voice (sound "scstd"). Each block tests one module.
-- =============================================================================================

-- 1. Default sound: two slightly detuned saws through the filter. Warm, a bit buzzy.
d1 $ n "0 3 7 10" # s "scstd"

-- 2. Chords: should be clean, no distortion or crackle.
d1 $ n "[0,4,7] [2,5,9] [-1,2,7] [0,4,7,11]" # s "scstd" # legato 1

-- 3. VCO waves. Listen for: saw (bright) -> square (hollow) as o1wave goes 0 -> 1.
d1 $ n "0 ~ 0 ~" # s "scstd" # o2lvl 0 # vcfcut 8000 # vcfenv 0 # o1wave "<0 0.5 1>"

-- 4. VCO 2 morph: saw -> pulse -> triangle -> sine, one per cycle (gets softer and rounder).
d1 $ n "0*4" # s "scstd" # o1lvl 0 # vcfcut 8000 # vcfenv 0 # o2wave "<0 1 2 3>"

-- 5. Pulse width: thin, nasal pulse (0.1) vs. full square (0.5).
d1 $ n "0*4" # s "scstd" # o1lvl 0 # o2wave 1 # vcfcut 8000 # vcfenv 0 # o2pw "<0.5 0.1>"

-- 6. VCO 3 one octave down adds weight. Listen for: fuller, deeper sound on the second cycle.
d1 $ n "0 3 7 10" # s "scstd" # o3lvl "<0 0.7>"

-- 7. Detune: o2fine 0 = static; 0.15 = slow beating "chorus".
d1 $ n "0" # s "scstd" # legato 1 # vcfenv 0 # o2fine "<0 0.15>"

-- 8. Filter cutoff (dark -> bright), no resonance.
d1 $ n "-12*8" # s "scstd" # vcfenv 0 # vcfres 0 # vcfcut (range 100 6000 $ slow 4 sine)

-- 9. Resonance: same sweep, strong resonance. Listen for: a smooth whistling peak, no clicks
--    or "zipper" steps.
d1 $ n "-12*8" # s "scstd" # vcfenv 0 # vcfres 0.9 # vcfcut (range 100 6000 $ slow 4 sine)

-- 10. Self-oscillation: no oscillators, filter alone sings a sine at the cutoff frequency.
d1 $ n "0" # s "scstd" # o1lvl 0 # o2lvl 0 # vcfres 1.1 # vcfenv 0 # vcfcut "<440 660 880>" # legato 1

-- 11. Filter envelope: classic "pew" / "wow" bass. vcfenv 0.8 = strong sweep down on each note.
d1 $ n "-24 -24 -12 -24" # s "scstd" # vcfcut 150 # vcfres 0.6 # vcfenv 0.8 # edec 0.25 # esus 0

-- 12. Negative envelope: the filter closes on the attack and opens as the note ends.
d1 $ n "-12 -5" # s "scstd" # vcfcut 3000 # vcfenv (-0.6) # eatk 0.3 # edec 0.5 # esus 0.2 # legato 1

-- 13. Drive: clean (0) -> saturated (1). Listen for: grittier, more harmonics, not much louder.
d1 $ n "-12 -12 -5 -12" # s "scstd" # vcfres 0.5 # vcfdrive "<0 1>"

-- 14. AR envelope (volume): slow swell pad vs. plucky.
d1 $ n "[0,4,7]" # s "scstd" # aratk "<1 0.005>" # arrel "<1.5 0.2>" # legato 1

-- 15. Long release: short notes that ring out and overlap.
d1 $ n "0 ~ ~ 7 ~ ~ 12 ~" # s "scstd" # legato 0.2 # arrel 2 # erel 2

-- 16. Analog character: drift 0 + vspread 0 = perfectly static; 1 + 1 = wobbly, unstable.
d1 $ n "0*4" # s "scstd" # legato 1 # drift "<0 1>" # vspread "<0 1>"

-- 17. Two filter characters — bass. vcfmodel 0 = MoogLadder (default, can self-oscillate),
--     vcfmodel 1 = MoogFF (different colour). Play A, then B, and switch back and forth.
-- 17A (MoogLadder):
d1 $ n "-24 -12 -24 -17" # s "scstd" # vcfcut 300 # vcfres 0.85 # vcfenv 0.6 # edec 0.3 # vcfmodel 0
-- 17B (MoogFF):
d1 $ n "-24 -12 -24 -17" # s "scstd" # vcfcut 300 # vcfres 0.85 # vcfenv 0.6 # edec 0.3 # vcfmodel 1

-- 18. Two filter characters — chords, filter more open.
-- 18A (MoogLadder):
d1 $ n "[0,3,7,10]" # s "scstd" # vcfcut 1200 # vcfres 0.5 # legato 1 # vcfmodel 0
-- 18B (MoogFF):
d1 $ n "[0,3,7,10]" # s "scstd" # vcfcut 1200 # vcfres 0.5 # legato 1 # vcfmodel 1

hush

-- =============================================================================================
-- Stage 2 — oscillator modulation. VCO 1 is the modulation source.
-- =============================================================================================

-- 19. VCO 1 as LFO -> vibrato on VCO 2. o1lvl 0 mutes VCO 1 itself. Listen for: a gentle,
--     even pitch wobble (5 times per second).
d1 $ n "0 7" # s "scstd" # legato 1 # o1lf 1 # o1lfrate 5 # o1lvl 0 # o2fm 0.01

-- 20. LF mode NOT muted: you hear VCO 1 itself as a slow ticking/buzz under the sound
--     (faithful to the original). Compare with 19.
d1 $ n "0" # s "scstd" # legato 1 # o1lf 1 # o1lfrate 3 # vcfcut 4000

-- 21. PWM: slow pulse-width sweep on one pulse wave. Listen for: a hollow sound that "breathes".
d1 $ n "-12" # s "scstd" # legato 1 # o1lf 1 # o1lfrate 0.5 # o1lvl 0 # o2wave 1 # o2pwm 0.9 # vcfcut 3000 # vcfenv 0

-- 22. PRESET: PWM pad (presets/pwm_pad.json). Wide, moving chords.
d1 $ n "<[0,4,7] [-3,0,4] [-7,-3,0] [-5,-1,2]>" # s "scstd" # o1lf 1 # o1lfrate 0.8 # o1lvl 0 # o2wave 1 # o2pwm 0.8 # o3lvl 0.6 # o3wave 1 # o3pwm 0.6 # o3oct 0 # o3fine (-0.08) # vcfcut 1800 # vcfres 0.2 # vcfenv 0.1 # aratk 0.4 # arrel 1.2 # erel 1.2 # legato 1

-- 23. Hard sync, step by step: o2oct moves VCO 2's tuning while it stays locked to VCO 1.
--     The pitch you hear stays the same; the tone changes (tearing, vocal). 0 = no change.
d1 $ n "0*4" # s "scstd" # o1lvl 0 # o2sync 1 # o2oct "<0 0.5 1 1.5>" # vcfcut 5000 # vcfenv 0

-- 24. Sync on/off: same notes, sync off (first cycle) vs on (second).
d1 $ n "0 3 7 12" # s "scstd" # o1lvl 0 # o2oct 1.3 # o2sync "<0 1>" # vcfcut 4000 # vcfenv 0

-- 25. PRESET: Sync lead (presets/sync_lead.json). The sweep is the classic sync sound.
d1 $ n "0 3 7 10 12 10 7 3" # s "scstd" # o1lvl 0.2 # o2oct 1.3 # o2sync 1 # vcfcut 2500 # vcfres 0.3 # vcfenv 0.3 # vcfkey 0.7 # edec 0.4 # esus 0.5 # o2oct (range 0.6 2 $ slow 2 sine)

-- 26. FM depth: 0 -> 0.05 -> 0.2 -> 0.6. Listen for: pure -> growl -> metallic -> noisy/clangy.
d1 $ n "-12*2" # s "scstd" # o1lvl 0 # o2wave 3 # vcfcut 8000 # vcfenv 0 # o2fm "<0 0.05 0.2 0.6>"

-- 27. PRESET: FM bell (presets/fm_bell.json). Clangy bell with a long ring.
d1 $ n "0 ~ 7 ~ 12 ~ 4 ~" # s "scstd" # o1oct 0.485 # o1lvl 0 # o2wave 3 # o2fm 0.12 # vcfcut 12000 # vcfenv 0 # aratk 0.001 # arrel 2.5 # erel 2.5 # legato 0.1

-- 28. VCO 2 -> VCO 3 FM: VCO 3 gets rough and metallic as o3fm rises.
d1 $ n "-12*2" # s "scstd" # o1lvl 0 # o2lvl 0.2 # o3lvl 0.8 # o3oct 0.7 # vcfcut 6000 # vcfenv 0 # o3fm "<0 0.1 0.3>"

-- 29. Keyboard tracking: a rising scale with a low cutoff. vcfkey 0 (first cycle): high notes get
--     duller and quieter. vcfkey 1 (second): every note equally bright.
d1 $ n "0 5 12 17 24 29 36" # s "scstd" # vcfcut 400 # vcfenv 0 # vcfkey "<0 1>"

hush

-- =============================================================================================
-- Stage 3 — noise, ring mod, sample & hold (S&H), lag processor.
-- Note: the filter was calibrated in Stage 3, so vcfcut now really means that frequency.
-- The default sound is a little brighter than before.
-- =============================================================================================

-- 30. Noise colours, one per cycle: white (bright hiss) -> pink (rain) -> brown (dark rumble).
--     They should sound about equally loud.
d1 $ n "0" # s "scstd" # o1lvl 0 # o2lvl 0 # nzlvl 1 # vcfmodel 1 # vcfcut 18000 # vcfenv 0 # legato 1 # nzcol "<0 0.5 1>"

-- 31. Noise as percussion: hi-hat (short, bright) and snare-ish (noise + low VCO).
d1 $ n "0*8" # s "scstd" # o1lvl 0 # o2lvl 0 # nzlvl 1 # aratk 0.001 # arrel 0.05 # erel 0.05 # legato 0.05 # vcfcut 9000 # vcfenv 0
d1 $ n "~ -24 ~ -24" # s "scstd" # o1lvl 0 # o2lvl 0.4 # o2wave 2 # nzlvl 1 # aratk 0.001 # arrel 0.15 # erel 0.15 # legato 0.1 # vcfcut 4000 # vcfenv 0

-- 32. PRESET: Wind (presets/wind.json). Noise through a resonant filter that wanders slowly.
d1 $ n "0" # s "scstd" # o1lvl 0 # o2lvl 0 # nzlvl 1 # nzcol 0.3 # m_sh_vcf 2.5 # shrate 1.5 # shlag 1 # vcfcut 900 # vcfres 0.85 # vcfenv 0 # vcfkey 0 # aratk 0.8 # arrel 1.5 # erel 1.5 # legato 1

-- 33. Ring mod alone: metallic, bell-like, not quite in tune. Changes as o1oct changes.
d1 $ n "0 5 7 12" # s "scstd" # o1lvl 0 # o2lvl 0 # rmlvl 1 # vcfcut 6000 # vcfenv 0 # o1oct "<0.485 0.25 1.1>"

-- 34. Ring mod mixed with the normal sound: adds a clangy edge.
d1 $ n "0 3 7 10" # s "scstd" # rmlvl "<0 0.6>"

-- 35. S&H -> pitch: ONE long note that jumps to a new random pitch 8 times per second.
--     This is the classic "computer" sound. (Each new note restarts the S&H.)
d1 $ n "0" # s "scstd" # legato 1 # o2lvl 0 # m_sh_pitch 12 # shrate 8 # vcfcut 3000 # vcfenv 0

-- 36. Same as 35, but shlag makes the jumps into GLIDES (slides). One cycle each:
--     shlag 0 = hard jumps (like 35), 0.5 = quick slides, 1 = slow continuous slides.
d1 $ n "0" # s "scstd" # legato 1 # o2lvl 0 # m_sh_pitch 12 # shrate 8 # shlag "<0 0.5 1>" # vcfcut 3000 # vcfenv 0

-- 37. S&H moves the FILTER instead of the pitch: the note stays the same, but its tone
--     jumps between dark and bright ("bubbling", "blip-blop"). Compare with 35: 35 = pitch jumps.
d1 $ n "-12" # s "scstd" # legato 1 # m_sh_vcf 2 # shrate 6 # vcfcut 800 # vcfres 0.7 # vcfenv 0

-- 38. Like 35 (pitch jumps), but the S&H reads a slow wave (VCO 3) instead of noise. So the jumps
--     are NOT random: they form a pattern that repeats, like a little arpeggio/sequencer.
d1 $ n "0" # s "scstd" # legato 1 # o2lvl 0 # shsrc 3 # o3oct (-3) # m_sh_pitch 12 # shrate 6 # vcfcut 3000 # vcfenv 0

-- 39. PRESET: Computer sequence (presets/computer_sequence.json).
d1 $ n "0" # s "scstd" # o1lvl 0 # o2wave 1 # o2pw 0.3 # m_sh_pitch 12 # shrate 8 # vcfcut 2500 # vcfres 0.5 # vcfenv 0 # arrel 0.1 # erel 0.1 # legato 1

-- 40. R2-D2-style, second draft: pure sine tones (no harsh ring mod) that jump and glide
--     randomly, with a fast trill from VCO 1 as an LFO. Two versions, compare them:
-- 40A "whistle": smoother, more like whistling.
d1 $ n "<12 19 15 24>" # s "scstd" # o1lf 1 # o1lfrate 16 # o1lvl 0 # o2wave 3 # o2lvl 1 # vcalvl 1 # o2fm 0.035 # m_sh_pitch 14 # shrate 8 # shlag 0.55 # vcfcut 5000 # vcfenv 0 # vcfdrive 0 # drift 0 # legato 0.9
-- 40B "chirp": faster, jumpier, a bit brighter.
d1 $ n "<12 19 15 24>" # s "scstd" # o1lf 1 # o1lfrate 22 # o1lvl 0 # o2wave 2.6 # o2lvl 1 # vcalvl 1 # o2fm 0.05 # m_sh_pitch 20 # shrate 14 # shlag 0.25 # vcfcut 4000 # vcfres 0.3 # vcfenv 0 # vcfdrive 0 # drift 0 # legato 0.9
-- 40C first draft (for comparison; ring mod of VCO 1's saw = harsh).
d1 $ n "<0 7 3 12>" # s "scstd" # o1oct 0.5 # o1lvl 0 # o2wave 3 # o2lvl 0.5 # rmlvl 0.6 # m_sh_pitch 24 # shrate 11 # shlag 0.35 # o2fm 0.03 # vcfcut 9000 # vcfenv 0 # legato 0.9
-- 40D "talking" (third draft): many short beeps at random pitches with random gaps
--     (like syllables). Each beep bends upward by a random amount (VCO 1 as a fast LFO ramps
--     VCO 2's pitch), so every beep sounds a bit different: "bwip", "bweeoo", "tt-tt".
--     (PRESET presets/r2d2_bleeps.json.) The "0.37 <~" shifts keep the random values independent:
--     rand, irand and degradeBy share one random stream, so unshifted they would be correlated.
d1 $ degradeBy 0.35 $ n (segment 16 $ (0.37 <~ irand 24) + 12) # s "scstd" # o1lf 1 # o1lvl 0 # o2wave 3 # o2lvl 1 # vcalvl 1 # aratk 0.003 # arrel 0.03 # erel 0.03 # vcfcut 6000 # vcfenv 0 # vcfdrive 0 # drift 0 # o1lfrate (range 4 30 $ 0.13 <~ rand) # o2fm (range 0 0.2 $ 0.71 <~ rand) # legato (range 0.4 0.9 $ 0.53 <~ rand)
-- 40E "beeps": short, clean beeps with no bends, in fast bursts, like a computer answering.
d1 $ degradeBy 0.4 $ n (segment 12 $ (0.37 <~ irand 24) + 12) # s "scstd" # o1lvl 0 # o2wave 2.5 # o2lvl 1 # vcalvl 1 # aratk 0.002 # arrel 0.02 # erel 0.02 # vcfcut 5000 # vcfenv 0 # vcfdrive 0 # drift 0 # legato 0.5
-- 40F both mixed: every cycle, randomly either talking (bends) or plain beeps.
d1 $ degradeBy 0.35 $ n (segment 16 $ (0.37 <~ irand 24) + 12) # s "scstd" # o1lf 1 # o1lvl 0 # o2wave 3 # o2lvl 1 # vcalvl 1 # aratk 0.003 # arrel 0.03 # erel 0.03 # vcfcut 6000 # vcfenv 0 # vcfdrive 0 # drift 0 # o1lfrate (range 4 30 $ 0.13 <~ rand) # o2fm (segment 1 $ wchooseBy (0.71 <~ rand) [(0, 1), (0.15, 1)]) # legato (range 0.4 0.9 $ 0.53 <~ rand)

-- 41. Lag processor: the PWM pad from 22, first with clicks (lagtime 0), then smooth (0.3).
d1 $ n "<[0,4,7] [-3,0,4]>" # s "scstd" # legato 1 # o1lf 1 # o1lfrate 0.8 # o1lvl 0 # o2wave 1 # o2pwm 0.8 # vcfcut 1800 # vcfenv 0.1 # aratk 0.4 # arrel 1.2 # lagtime "<0 0.3>"

-- 42. Filter calibration check: the filter alone sings the note A (440 Hz), then A an octave up.
--     Compare with any tuner or piano: it should be in tune.
d1 $ n "0" # s "scstd" # o1lvl 0 # o2lvl 0 # vcfres 1.1 # vcfenv 0 # vcfkey 0 # legato 1 # vcfcut "<440 880>"

hush
